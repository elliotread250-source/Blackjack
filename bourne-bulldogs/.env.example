# Resend (https://resend.com). Free tier is plenty for a club site.
RESEND_API_KEY=
# Where contact and merch order emails land.
CONTACT_TO_EMAIL=bournebulldogs@gmail.com
# Sender address. Must be on a domain verified in Resend, e.g.
# "Bourne Bulldogs <hello@bournebulldogs.com>". Leave blank to use Resend's
# test sender, which can only deliver to the Resend account owner's inbox.
CONTACT_FROM_EMAIL=
# Canonical URL used for SEO, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.bournebulldogs.com
