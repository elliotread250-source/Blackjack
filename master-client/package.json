{
  "name": "master-client",
  "productName": "Master Client",
  "version": "0.1.0",
  "description": "Companion launcher for Minecraft Bedrock Edition on Windows",
  "main": "./out/main/index.js",
  "author": "Elliot Read",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/elliotread250-source/Blackjack/tree/main/master-client",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "assets": "node scripts/build-addons.mjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "release": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.8.9",
    "pngjs": "^7.0.0",
    "sql.js": "^1.14.2",
    "uiohook-napi": "^1.5.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4",
    "yazl": "^3.3.1",
    "zustand": "^5.0.15"
  }
}
